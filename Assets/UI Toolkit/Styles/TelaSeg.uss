/* ========== BASE ========== */
.root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgb(10, 15, 28);
    padding: 16px;
}

Label {
    white-space: normal;
}

/* ========== TOPBAR ========== */
.topbar {
    flex-direction: row;
    align-items: center;
    background-color: rgb(17, 24, 39);
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    border-radius: 14px;
    padding: 10px 16px;
    margin-bottom: 16px;
}

.brandTitle {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.brandSub {
    color: rgb(139, 157, 195);
    font-size: 16px;
    flex-grow: 1;
}

.navActive {
    color: rgb(74, 222, 128);
    font-size: 16px;
    -unity-font-style: bold;
    margin-right: 20px;
}

.dateText {
    color: rgb(185, 199, 219);
    font-size: 16px;
    background-color: rgb(11, 17, 32);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    border-radius: 10px;
    padding: 4px 10px;
}

/* ========== LAYOUT ========== */
.contentRow {
    flex-grow: 1;
    flex-direction: row;
}

.filtros {
    width: auto;
    background-color: rgb(17, 24, 39);
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    border-radius: 16px;
    padding: 16px;
    margin-right: 16px;
    overflow: scroll;
}

.mapa {
    flex-grow: 1;
    background-color: rgb(17, 24, 39);
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    border-radius: 16px;
    padding: 16px;
    margin-right: 16px;
    flex-direction: column;
    min-width: 50%;
}

.resumo {
    width: 30%;
    background-color: rgb(17, 24, 39);
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    border-radius: 16px;
    padding: 16px;
    overflow: scroll;
}

.titulo {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.subtitulo {
    color: rgb(160, 176, 208);
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 16px;
    margin-bottom: 8px;
}

.textoSec {
    color: rgb(107, 122, 153);
    font-size: 16px;
}

.btnFiltro {
    background-color: rgb(11, 17, 32);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    border-radius: 10px;
    color: rgb(226, 232, 240);
    font-size: 16px;
    padding: 8px;
    margin: 8px 0;
    -unity-text-align: middle-left;
}

/* ========== POPUP DE CRIMES (atual) ========== */
.crime-popup {
    position: absolute;
    background-color: rgb(26, 37, 60);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    border-radius: 12px;
    padding: 12px;
    width: 280px;
    font-size: 16px;
}

.popup-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.popup-title {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
}

.close-btn {
    background-color: transparent;
    color: rgb(185, 199, 219);
    font-size: 16px;
    border-width: 0;
}

.crime-list {
    max-height: 200px;
    margin-bottom: 8px;
    overflow: scroll;
}

.crime-buttons-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.crime-button {
    background-color: rgb(42, 58, 92);
    color: rgb(226, 232, 240);
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    border-radius: 20px;
    padding: 4px 10px;
    margin: 4px;
    font-size: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.crime-button-selected {
    background-color: rgb(59, 130, 246);
    color: white;
    border-color: rgb(96, 165, 250);
}

.popup-footer {
    flex-direction: column;
    margin-top: 6px;
}

.selected-count {
    color: rgb(139, 157, 195);
    font-size: 16px;
    margin-bottom: 6px;
}

.popup-buttons {
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
}

.popup-btn {
    background-color: rgb(42, 58, 92);
    color: white;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 16px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
}

.popup-btn-primary {
    background-color: rgb(74, 222, 128);
    color: rgb(10, 15, 28);
}

/* ========== DROPDOWN DE ANO ========== */
.dataRange {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.dateField {
    flex-grow: 1;
    background-color: rgb(11, 17, 32);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    border-radius: 8px;
    padding: 4px;
    margin-right: 4px;
    min-width: 100px;
}

.dateField .unity-base-dropdown-field__label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    padding: 4px 8px;
}

.dateField .unity-base-dropdown-field__input {
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.dateField .unity-popup-field__input {
    max-height: 200px;
    overflow: scroll;
    background-color: rgb(26, 37, 60);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
}

.dateField .unity-popup-field__input .unity-list-view__item {
    color: rgb(226, 232, 240);
    font-size: 16px;
    padding: 4px 8px;
    white-space: normal;
    background-color: rgb(26, 37, 60);
}

.dateField .unity-popup-field__input .unity-list-view__item:hover {
    background-color: rgb(42, 58, 92);
}

.btnAplicar {
    background-color: rgb(42, 58, 92);
    color: white;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 16px;
    flex-shrink: 0;
}

/* ========== DROPDOWN DE ESTADO ========== */
.mapHeader {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.mapTitleWrap {
    flex-grow: 1;
}

.mapActions {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    min-width: 200px;
}

.estadoDropdown {
    background-color: rgb(11, 17, 32);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    border-radius: 8px;
    min-width: 150px;
    font-size: 16px;
    color: white;
}

.estadoDropdown .unity-base-dropdown-field__label {
    color: rgb(74, 222, 128);
    font-size: 16px;
    -unity-font-style: bold;
    padding: 6px 8px;
}

.estadoDropdown .unity-base-dropdown-field__input {
    background-color: rgb(11, 17, 32);
    border-radius: 8px;
    padding: 6px 8px;
    color: rgb(245, 245, 245);
    font-size: 16px;
}

.estadoDropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(74, 222, 128);
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

.estadoDropdown .unity-popup-field__input {
    background-color: rgb(26, 37, 60);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    border-radius: 8px;
    max-height: 250px;
    overflow: scroll;
}

.estadoDropdown .unity-popup-field__input .unity-list-view__item {
    color: rgb(226, 232, 240);
    font-size: 16px;
    padding: 8px 12px;
    background-color: rgb(26, 37, 60);
    white-space: normal;
}

.estadoDropdown .unity-popup-field__input .unity-list-view__item:hover {
    background-color: rgb(42, 58, 92);
}

/* ========== LEGENDA ========== */
.cardLegend {
    background-color: rgb(15, 22, 34);
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    border-radius: 12px;
    padding: 12px;
    margin-top: 20px;
}

.heatGradient {
    height: 20px;
    margin: 8px 0;
    border-radius: 10px;
    flex-direction: row;
}

.legendaLinha {
    flex-direction: row;
    justify-content: space-between;
}

/* ========== MAPA ========== */
.mapContainer {
    flex-grow: 1;
    background-color: rgb(11, 17, 32);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    padding: 8px;
    position: relative;
}

.mapViewport {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.mapaBrasil {
    width: 100%;
    height: 100%;
}

/* ========== CARD DE ESTADO ========== */
.stateCard {
    position: absolute;
    left: 12px;
    bottom: 12px;
    background-color: rgba(11, 17, 32, 0.9);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    padding: 12px;
    width: 240px;
}

.stateHead {
    color: rgb(74, 222, 128);
    font-size: 16px;
}

.stateTitle {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin: 4px 0 8px;
}

.stateRow {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.riskBadge {
    color: rgb(249, 115, 22);
    -unity-font-style: bold;
    font-size: 16px;
}

.stateValue {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
}

/* ========== RESUMO ========== */
.kpiCard {
    background-color: rgb(11, 17, 32);
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    border-radius: 14px;
    padding: 12px;
    margin: 5px;
    flex-grow: 1;
}

.valor {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    margin-top: 4px;
}

/* ========== ESTILOS ADICIONAIS (dropdowns e scroll) ========== */
.estadoDropdown .unity-popup-field__input {
    max-width: 100%;
    overflow: hidden;
}

.estadoDropdown .unity-popup-field__input .unity-list-view__item,
.estadoDropdown .unity-base-dropdown_item {
    white-space: normal;
    max-width: 100%;
    padding-left: 8px;
    padding-right: 8px;
}

.unity-base-dropdown__item {
    white-space: normal;
    overflow: hidden;
}

.unity-popup-field__label {
    min-width: auto;
    color: #FFFFFF;
    align-self: center;
}

DropdownField .unity-base-popup-field__text {
    color: #fff;
}

DropdownField .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(74, 222, 128);
}

DropdownField Label {
    padding: 5px;
    font-size: 16px;
}

/* Scrollbars personalizadas */
Scroller .unity-repeat-button {
    background-color: #1F2D4C;
    border-color: #1F2D4C;
    -unity-background-image-tint-color: rgb(74, 222, 128);
}

Scroller .unity-base-slider__tracker {
    background-color: #1F2D4C;
    border-color: #1F2D4C;
}

Scroller .unity-base-slider__dragger {
    background-color: #4ADE80;
    width: 100%;
}

/* Gráfico de linhas */
#LineChartContainer {
    margin-top: 16px;
    background-color: #0a1a2e;
    border-radius: 8px;
    padding: 8px;
}

/* Estilo dos rótulos do gráfico */
.unity-text-element {
    -unity-text-align: middle-center;
}

/* ========== EXPORTAÇÃO ========== */
.cardExport {
    background-color: rgb(15, 22, 34);
    border-width: 1px;
    border-color: rgb(31, 42, 68);
    border-radius: 12px;
    padding: 12px;
    margin-top: 16px;
}

.textFieldExport {
    background-color: rgb(11, 17, 32);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    border-radius: 8px;
    padding: 4px;
    margin: 8px 0;
    color: white;
}

.textFieldExport .unity-text-field__label {
    color: rgb(160, 176, 208);
    font-size: 16px;
}

.textFieldExport .unity-text-field__input {
    color: white;
    font-size: 16px;
}

.btnExport {
    background-color: rgb(42, 58, 92);
    color: white;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 16px;
    border-width: 0;
    flex-grow: 1;
    text-align: center;
    transition: background-color 0.2s;
}

.btnExport:hover {
    background-color: rgb(59, 130, 246);
}

.btnExportFolder {
    background-color: rgb(31, 42, 68);
    color: white;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    border-width: 0;
    width: 100%;
    text-align: center;
    margin-top: 8px;
}

.btnExportFolder:hover {
    background-color: rgb(59, 130, 246);
}

/* Campo de texto para nome do arquivo */
.textFieldExport {
    background-color: rgb(11, 17, 32);
    border-width: 1px;
    border-color: rgb(42, 58, 92);
    border-radius: 8px;
    padding: 4px;
    margin: 8px 0;
    color: #000;
}
.textFieldExport .unity-text-field__label {
    color: rgb(160, 176, 208);
    font-size: 16px;
}
.textFieldExport .unity-text-field__input {
    color: #000;
    font-size: 16px;
}
.btnExport {
    background-color: rgb(42, 58, 92);
    color: white;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 16px;
    border-width: 0;
    flex-grow: 1;
    text-align: center;
}
.btnExport:hover {
    background-color: rgb(59, 130, 246);
}