.root {
    background-color: red;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: #0A0F1C;
    padding: 16px;
}

Label {
    white-space: normal;
}

.topbar {
    flex-direction: row;
    align-items: center;
    background-color: #111827;
    border-width: 1px;
    border-color: #1F2A44;
    border-radius: 14px;
    padding: 10px 16px;
    margin-bottom: 16px;
}

.brandTitle {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.brandSub {
    color: #8B9DC3;
    font-size: 12px;
    flex-grow: 1;
}

.navActive {
    color: #4ADE80;
    font-size: 14px;
    -unity-font-style: bold;
    margin-right: 20px;
}

.dateText {
    color: #B9C7DB;
    font-size: 12px;
    background-color: #0B1120;
    border-width: 1px;
    border-color: #2A3A5C;
    border-radius: 10px;
    padding: 4px 10px;
}

.contentRow {
    flex-grow: 1;
    flex-direction: row;
}

.filtros {
    width: 280px;
    background-color: #111827;
    border-width: 1px;
    border-color: #1F2A44;
    border-radius: 16px;
    padding: 16px;
    margin-right: 16px;
}

.mapa {
    flex-grow: 1;
    background-color: #111827;
    border-width: 1px;
    border-color: #1F2A44;
    border-radius: 16px;
    padding: 16px;
    margin-right: 16px;
    flex-direction: column;
}

.resumo {
    width: 260px;
    background-color: #111827;
    border-width: 1px;
    border-color: #1F2A44;
    border-radius: 16px;
    padding: 16px;
}

.titulo {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.subtitulo {
    color: #A0B0D0;
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 16px;
    margin-bottom: 8px;
}

.textoSec {
    color: #6B7A99;
    font-size: 12px;
}

.btnFiltro {
    background-color: #0B1120;
    border-width: 1px;
    border-color: #2A3A5C;
    border-radius: 10px;
    color: #E2E8F0;
    font-size: 13px;
    padding: 8px;
    margin: 8px 0;
    -unity-text-align: middle-left;
}

.popup {
    position: absolute;
    top: 100px;
    left: 40px;
    background-color: #1A253C;
    border-width: 1px;
    border-color: #2A3A5C;
    border-radius: 12px;
    padding: 12px;
    width: 340px;
    max-height: 460px;
    flex-direction: column;
    overflow: hidden;
}




.popupHeader {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.popupTitle {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
}

.closeBtn {
    background-color: transparent;
    color: #B9C7DB;
    font-size: 16px;
    border-width: 0;
}

.crimeList {
    height: 300px;
    margin-bottom: 12px;
    flex-shrink: 0;
    padding-right: 12px;  
}




.crimeList Toggle {
    position: relative;
    width: 100%;
    min-height: 44px;
    margin: 3px 0;
    padding: 8px 50px 8px 4px;
    align-items: center;   
}




.crimeList Toggle Label {
    color: #E2E8F0;
    font-size: 14px;
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 240px;
}


.crimeList Toggle > VisualElement {
    position: absolute;
    right: 30px;
    top: 50%;
    translate: 0 -50%;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    flex-grow: 0;
}

.crimeList Toggle .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
}


.popupFooter {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    flex-shrink: 0;
}


/* Largura total do scroller */
.crimeList .unity-scroller--vertical {
    width: 6px;
}

/* O TRILHO de fundo (esse cinzão feio) - deixa transparente */
.crimeList .unity-scroller--vertical .unity-base-slider {
    background-color: transparent;
}

.crimeList .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.crimeList .unity-scroller--vertical #unity-dragger {
    background-color: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
    width: 6px;
    border-width: 0;
    margin-left: 0;
}


/* Esconde as setinhas */
.crimeList .unity-scroller__low-button,
.crimeList .unity-scroller__high-button {
    display: none;
}



.selectedCountLabel {
    color: #8B9DC3;
    font-size: 11px;
}

.popupButton {
    background-color: #2A3A5C;
    color: white;
    border-radius: 8px;
    padding: 7px 16px;  
    font-size: 12px;    
}


.popupButtonPrimary {
    background-color: #22C55E;  
    color: #052e16;           
    -unity-font-style: bold;     
}

.dataRange {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}




/* Container que coloca os campos LADO A LADO */
.dateRow {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

/* Cada campo de data */
.dateField {
    background-color: #0B1120;
    border-width: 1px;
    border-color: #2A3A5C;
    border-radius: 8px;
    height: 36px;
    flex-grow: 1;
    margin-right: 8px;
}

/* Garante que o cursor pisque e o campo seja clicável */
.dateField .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: #E2E8F0;
    font-size: 14px;
    -unity-text-align: middle-center;
    cursor: text;
}

/* Borda destacada ao focar (ajuda a ver que tá ativo) */
.dateField:focus {
    border-color: #4ADE80;
}

.anoDropdown {
    width: 110px;
    min-width: 110px;
    flex-shrink: 0;        /* ⬅️ impede o campo de encolher na linha */
}

.anoDropdown .unity-base-popup-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    padding-left: 4px;
    padding-right: 4px;    /* ⬅️ voltei pra pouco padding */
}

.anoDropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}






.btnAplicar {
    background-color: #2A3A5C;
    color: white;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
}

.cardLegend {
    background-color: #0F1622;
    border-width: 1px;
    border-color: #1F2A44;
    border-radius: 12px;
    padding: 12px;
    margin-top: 20px;
}

.heatGradient {
    height: 20px;
    margin: 8px 0;
    border-radius: 10px;
    flex-direction: row;
}

.legendaLinha {
    flex-direction: row;
    justify-content: space-between;
}

.mapContainer {
    flex-grow: 1;
    background-color: #0B1120;
    border-radius: 16px;
    border-width: 1px;
    border-color: #1F2A44;
    padding: 8px;
    position: relative;
}

.mapViewport {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.mapaBrasil {
    width: 100%;
    height: 100%;
}

.stateCard {
    position: absolute;
    left: 12px;
    bottom: 12px;
    background-color: rgba(11, 17, 32, 0.9);
    border-radius: 16px;
    border-width: 1px;
    border-color: #2A3A5C;
    padding: 12px;
    width: 240px;
}

.stateHead {
    color: #4ADE80;
    font-size: 10px;
}

.stateTitle {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin: 4px 0 8px;
}

.stateRow {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.riskBadge {
    color: #F97316;
    -unity-font-style: bold;
}

.stateValue {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
}

.kpiCard {
    background-color: #0B1120;
    border-width: 1px;
    border-color: #1F2A44;
    border-radius: 14px;
    padding: 12px;
    margin-bottom: 12px;
}

.valor {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    margin-top: 4px;
}