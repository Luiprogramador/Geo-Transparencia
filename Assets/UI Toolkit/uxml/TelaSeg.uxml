<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="GraficoPizza" src="project://database/Assets/UI%20Toolkit/uxml/GraficoPizza.uxml?fileID=9197481963319205126&amp;guid=cea129fa34d192b4c9bc3b078752b815&amp;type=3#GraficoPizza"/>
    <ui:Template name="MapaBrasil" src="project://database/Assets/UI%20Toolkit/uxml/TelaEstados.uxml?fileID=9197481963319205126&amp;guid=c62b2133e7f91de49bcaf5f5d7d25276&amp;type=3#TelaEstados"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/TelaSeg.uss"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/GraficoPizza.uss"/>

    <ui:VisualElement name="Root" class="root">
        <ui:VisualElement class="topbar">
            <ui:Label text="Transparência Visual" class="brandTitle"/>
            <ui:Label text="de Dados Públicos" class="brandSub"/>
            <ui:Label text="Segurança Pública" class="navActive"/>
            <ui:Label text="2025-2026" class="dateText"/>
        </ui:VisualElement>

        <ui:VisualElement class="contentRow">
            <!-- Filtros -->
            <ui:VisualElement class="filtros">
                <ui:Label text="FILTROS" class="titulo"/>
                <ui:Label text="Refinar os dados" class="textoSec"/>
                <ui:Button name="CrimeButton" text="Tipo de Crime (todos)" class="btnFiltro"/>
                <ui:Label text="Período (opcional)" class="subtitulo"/>
                <ui:VisualElement class="dataRange">
                    <ui:DropdownField name="AnoDropdown" label="Ano" class="dateField"/>
                    <ui:Button name="AplicarPeriodoBtn" text="Aplicar" class="btnAplicar"/>
                </ui:VisualElement>
                <ui:VisualElement class="cardLegend">
                    <ui:Label text="LEGENDA DE RISCO" class="subtitulo"/>
                    <ui:Label text="Quanto mais quente, maior o risco." class="textoSec"/>
                    <ui:VisualElement name="HeatGradient" class="heatGradient"/>
                    <ui:VisualElement class="legendaLinha">
                        <ui:Label text="Baixo" class="textoSec"/>
                        <ui:Label text="Médio" class="textoSec"/>
                        <ui:Label text="Alto" class="textoSec"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Exportação -->
                <ui:VisualElement class="cardExport">
                    <ui:Label text="EXPORTAR DADOS" class="subtitulo"/>
                    <ui:Label text="Baixe os dados atuais (filtros aplicados)" class="textoSec"/>
                    <ui:TextField name="FileNameField" label="Nome do arquivo" value="ocorrencias" class="textFieldExport" />
                    <ui:VisualElement style="flex-direction: row; gap: 8px; margin-top: 8px;">
                        <ui:Button name="ExportExcelBtn" text="Salvar como Excel" class="btnExport"/>
                        <ui:Button name="ExportCsvBtn" text="Salvar como CSV" class="btnExport"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Mapa -->
            <ui:VisualElement class="mapa">
                <ui:VisualElement class="mapHeader">
                    <ui:VisualElement class="mapTitleWrap">
                        <ui:Label text="MAPA DE CALOR — BRASIL" class="titulo"/>
                        <ui:Label text="Visualize a distribuição de ocorrências por estado." class="textoSec"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="mapContainer" class="mapContainer">
                    <ui:VisualElement class="mapViewport">
                        <ui:Instance template="MapaBrasil" name="Mapa" class="mapaBrasil"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="StateDetail" class="stateCard">
                        <ui:Label text="ESTADO SELECIONADO" class="stateHead"/>
                        <ui:Label text="Nenhum" name="stateTitle" class="stateTitle"/>
                        <ui:VisualElement class="stateRow">
                            <ui:Label text="Risco:" class="textoSec"/>
                            <ui:Label text="—" name="riskBadge" class="riskBadge"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="stateRow">
                            <ui:Label text="Ocorrências:" class="textoSec"/>
                            <ui:Label text="0" name="stateValue" class="stateValue"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Resumo + Gráficos -->
            <ui:VisualElement class="resumo">
                <ui:Label text="RESUMO GERAL" class="titulo"/>
                <ui:VisualElement style="flex-direction: row; justify-content: space-evenly;">
                    <ui:VisualElement class="kpiCard">
                        <ui:Label text="CRIMES REGISTRADOS" class="textoSec"/>
                        <ui:Label name="totalCrimesLabel" text="0" class="valor"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="kpiCard">
                        <ui:Label text="MAIOR OCORRÊNCIA" class="textoSec"/>
                        <ui:Label name="topCrimeLabel" text="-" class="valor"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Instance template="GraficoPizza"/>
                <ui:VisualElement style="margin-top: 16px;">
                    <ui:Label text="EVOLUÇÃO MENSAL" class="subtitulo" style="margin-bottom: 8px;"/>
                    <ui:VisualElement name="LineChartContainer" style="height: 220px; background-color: #0f0f1a; border-radius: 8px; overflow: hidden;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>